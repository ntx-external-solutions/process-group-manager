# Secret used to encrypt the session cookie holding the Process Manager token.
# At least 32 characters. Generate one with:
#   openssl rand -base64 48
#
# Set this in the Vercel project's Environment Variables, not in the repository.
AUTH_SECRET=

# Optional. Where the SCIM user directory lives, used to turn the logon in a Champion
# column into the numeric user id the champion endpoints want.
#
# Leave it unset. https://api.promapp.com serves every tenant, whatever origin the
# tenant itself is on; this exists only in case that stops being true.
#
# The SCIM API *key* is never configured here. It is typed in by the operator when a
# file needs one, held in that browser tab, and stored nowhere.
# SCIM_BASE_URL=https://api.promapp.com
